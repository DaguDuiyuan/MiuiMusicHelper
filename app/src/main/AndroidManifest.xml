<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- No activity on purpose: the module has nothing to configure, so all LSPosed
             needs is the metadata below.

             These stay so a manager that only understands the classic API still lists
             the app as a module. minversion 102 makes older frameworks refuse it
             outright instead of loading it half way and failing at the entry point,
             which no longer exists in the old shape. The real entry point is
             META-INF/xposed/java_init.list. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
    </application>
</manifest>
